# --- Telegram Bot API (BotFather) ---
# The bot must be an administrator of the channel to receive new-post updates.
# Bot API cannot read message history, so only NEW posts are mirrored.
TG_BOT_TOKEN=123456:ABC-DEF...
# Public channel: @name, t.me/name or https://t.me/name
TG_CHANNEL=@yourchannel
# Optional: Bot API server override (defaults to https://api.telegram.org)
# TG_API_BASE=https://api.telegram.org

# --- API security: bearer token the website sends in the Authorization header ---
TG_READER_TOKEN=generate-a-long-random-token

# --- Storage (Docker image defaults to /data/...) ---
TG_DB_PATH=/data/reader.db
TG_MEDIA_DIR=/data/media
# Where Telegram Desktop chat-export folders (ChatExport_...) are looked up.
TG_EXPORT_DIR=/data/exports

# --- Tuning ---
# Long-poll wait in seconds per getUpdates call.
TG_POLL_TIMEOUT=25
# Backoff in seconds after a failed sync cycle.
TG_SYNC_INTERVAL=60

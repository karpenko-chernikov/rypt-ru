# Локальная разработка (опционально). Скопируйте в .env и не коммитьте.
# DJANGO_SETTINGS_MODULE=rypt.settings.dev

# Production — обычно /etc/rypt.env на сервере, не этот файл:
# DJANGO_SECRET_KEY=сгенерируйте-длинный-секрет
# ALLOWED_HOSTS=rypt.folomin.com
# WAGTAILADMIN_BASE_URL=https://rypt.folomin.com
# DJANGO_SETTINGS_MODULE=rypt.settings.production

# Telegram-зеркало: reader-сервис на зарубежном сервере (см. reader/README.md).
# TG_READER_URL=https://tg-reader.example.com
# TG_READER_TOKEN=тот-же-токен-что-и-в-reader
# TG_CHANNEL=mychannel

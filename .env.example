# Локальная разработка (опционально). Скопируйте в .env и не коммитьте.
# DJANGO_SETTINGS_MODULE=rypt.settings.dev

# Production — обычно /etc/rypt.env на сервере, не этот файл:
# DJANGO_SECRET_KEY=сгенерируйте-длинный-секрет
# ALLOWED_HOSTS=rypt.folomin.com
# WAGTAILADMIN_BASE_URL=https://rypt.folomin.com
# ENABLE_WAGTAIL_ADMIN=1  # только для staging: открывает /redaktura/ вне DEBUG
# DJANGO_SETTINGS_MODULE=rypt.settings.production

# Каталоги данных в production (обычно /etc/rypt.env на сервере):
# DATABASE_PATH=/var/lib/rypt/db/db.sqlite3
# MEDIA_ROOT=/var/lib/rypt/media
# STATIC_ROOT=/srv/rypt/current/static

# Аналитика Umami (self-hosted). Пустые значения = трекинг выключен.
# UMAMI_SCRIPT_URL=https://analytics.example.com/script.js
# UMAMI_WEBSITE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# UMAMI_DOMAINS=rypt.folomin.com   # необязательно: ограничить трекинг доменом

# Telegram-зеркало: reader-сервис на зарубежном сервере (см. reader/README.md).
# Эти же URL/токен используются для уведомлений о новых заявках на «Доске».
# TG_READER_URL=https://tg-reader.example.com
# TG_READER_TOKEN=тот-же-токен-что-и-в-reader
# TG_CHANNEL=mychannel
